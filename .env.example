# Только имена. Значения задаются через `wrangler secret put <NAME>` и никогда не коммитятся.
JWT_SECRET=
# Публичный site key (можно в wrangler.toml [vars]); секрет — только секретом Worker.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TELEGRAM_BOT_TOKEN=
ADMIN_ACCESS_AUD=

# Astra Pay (этап 1). Включённым считается только "on". Дочерние флаги не
# работают без PAYMENTS_ENABLED. Реальные операции — только после Production
# Gate и юридического заключения.
PAYMENTS_ENABLED=off
DEPOSITS_ENABLED=off
PURCHASES_ENABLED=off
POOL_ENABLED=off
PAYOUTS_ENABLED=off
SWEEP_ENABLED=off
# Создать таблицы pay_* при выключенных деньгах (проверка схемы). По умолчанию off.
PAY_SCHEMA_CHECK=off
# nile (тестнет) или mainnet. Mainnet — только этап 12.
PAY_NETWORK=nile
# Пусто — стандартный адрес USDT для выбранной сети.
PAY_USDT_CONTRACT=
