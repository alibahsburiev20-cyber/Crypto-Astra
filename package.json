{
  "name": "crypto-astra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/embed-client.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "embed": "node scripts/embed-client.mjs",
    "build:minigame": "node scripts/build-minigame.mjs",
    "build:arcade": "node scripts/build-arcade.mjs",
    "check": "npm run typecheck && npm run typecheck:scripts && npm test",
    "seed": "tsx scripts/seed-local.ts",
    "simulate": "tsx scripts/simulate-economy.ts",
    "check-ledger": "tsx scripts/check-ledger.ts",
    "verify-snapshot": "tsx scripts/verify-snapshot.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "config:sync": "node scripts/sync-wrangler.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --preview",
    "build": "node scripts/embed-client.mjs",
    "ads-forecast": "tsx scripts/ads-forecast.ts",
    "pay:loadtest": "tsx scripts/pay-loadtest.ts",
    "pay:rehearse": "tsx scripts/pay-bsc-rehearsal.ts",
    "health": "tsx scripts/health-check.ts",
    "smoke:arcade": "tsx scripts/arcade-smoke.ts",
    "restore:drill": "bash scripts/restore-drill.sh",
    "pay:hot-address": "tsx scripts/hot-address.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.20.5",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0"
  }
}
